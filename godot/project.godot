; Engine configuration file.
;
; Generated by hand for the experiment/godot-port branch.
; Open this file in Godot 4.3+ to load the project.
;
; This is a scaffold for an experimental rewrite of daidai using the
; Godot engine, primarily motivated by the desire to ship a real
; native Xbox build (something the Three.js + WebView2 path can't do
; because Xbox's Edge browser ships a broken/limited WebGL2 stack).
;
; The TypeScript/Three.js codebase on `main` is the canonical version
; and is NOT replaced by this branch. This subdirectory is a parallel
; rewrite kept under godot/ so the two can be compared side by side.

config_version=5

[application]

config/name="DaiDai"
config/description="呆呆虫之豆豆潭 3D 复刻版 (Godot port)"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

snake_up={
