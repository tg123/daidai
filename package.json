{
  "name": "daidai-worm",
  "version": "1.0.0",
  "private": true,
  "description": "DaiDai Worm 3D web game — test harness",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "serve:dist": "vite preview --outDir dist",
    "build": "vite build",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:dist": "cross-env TEST_DIST=1 playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "cross-env": "^7.0.3",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "three": "^0.128.0"
  }
}
